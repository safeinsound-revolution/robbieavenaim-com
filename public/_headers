# Cloudflare Workers Static Assets response headers.
# Astro fingerprints everything in /_astro/, so a changed file gets a new name
# and the old one can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# CMS uploads keep their filename when replaced, so these get a day rather
# than forever; stale-while-revalidate hides the recheck from the visitor.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
