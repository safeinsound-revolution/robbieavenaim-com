/** Joseph Derrick's mark, used once in the footer credit. Ported from the
 *  Safe in Sound site, which carries the same credit.
 *
 *  Inlined rather than `<img src="/jd.svg">` on purpose: the traced file has a
 *  hard-coded black fill and this footer is dark, so a linked copy would render
 *  black-on-dark and simply vanish. Inline, the fill is `currentColor`, so the
 *  mark takes the colour of the link it sits in — including on hover — and
 *  there is no second request for a 4 KB file.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
