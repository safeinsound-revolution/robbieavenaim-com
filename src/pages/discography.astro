---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const releases = (await getCollection("discography")).sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity));
---
<Layout title="Discography — Robbie Avenaim">
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <p class="eyebrow mb-3">Discography</p>
    <h1 class="mb-12 text-3xl font-bold tracking-tight sm:text-5xl">Releases</h1>

    <div class="grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-3 lg:grid-cols-4">
      {releases.map((r) => (
        <div>
          {r.data.image && (
            <div class="aspect-square overflow-hidden border border-line bg-surface">
              <img src={r.data.image} alt={r.data.title} class="h-full w-full object-cover" />
            </div>
          )}
          <h2 class="mt-3 text-sm font-bold leading-snug">
            {r.data.title}
            {r.data.soldOut && <span class="ml-2 font-mono text-[0.65rem] uppercase tracking-wide text-accent">Sold out</span>}
          </h2>
          <p class="mt-1 text-xs leading-relaxed text-muted">{r.data.credits}</p>
          {r.data.label && <p class="mt-1 font-mono text-[0.7rem] text-muted">{r.data.label}</p>}
          {r.data.links.length > 0 && (
            <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
              {r.data.links.map((l) => (
                <a href={l.url} target="_blank" rel="noopener noreferrer" class="font-mono text-[0.7rem] uppercase tracking-wide text-paper underline decoration-accent hover:text-accent">
                  {l.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
</Layout>
