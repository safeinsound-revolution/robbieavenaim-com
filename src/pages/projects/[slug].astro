---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

type ParsedVideo =
  | { type: "embed"; src: string }
  | { type: "file"; src: string; mime: string };

// Turn a pasted URL into either a privacy-friendly embed (YouTube via
// youtube-nocookie.com, Vimeo with Do-Not-Track) or a self-hosted file.
function parseVideo(raw: string): ParsedVideo | null {
  const url = raw?.trim();
  if (!url) return null;
  const yt = url.match(
    /(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([\w-]{11})/,
  );
  if (yt) return { type: "embed", src: `https://www.youtube-nocookie.com/embed/${yt[1]}` };
  const vimeo = url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  if (vimeo) return { type: "embed", src: `https://player.vimeo.com/video/${vimeo[1]}?dnt=1` };
  return { type: "file", src: url, mime: /\.webm(\?|$)/i.test(url) ? "video/webm" : "video/mp4" };
}

const videos = project.data.videos.map((v) => ({ ...v, parsed: parseVideo(v.url) }));
const hasVideos = videos.some((v) => v.parsed);
---
<Layout title={`${project.data.title} — Robbie Avenaim`} description={project.data.summary}>
  <section>
    {project.data.heroImage && (
      <div class="aspect-[16/9] w-full overflow-hidden sm:aspect-[21/9]">
        <img src={project.data.heroImage} alt={project.data.title} class="h-full w-full object-cover" />
      </div>
    )}
    <div class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
      <a href="/projects/" class="font-mono text-xs uppercase tracking-[0.1em] text-muted hover:text-accent">← Projects</a>
      <p class="eyebrow mt-6 mb-3">Project</p>
      <h1 class="mb-3 text-3xl font-bold tracking-tight sm:text-5xl">{project.data.title}</h1>
      <p class="mb-10 text-lg leading-relaxed text-muted">{project.data.summary}</p>

      {project.data.externalUrl && (
        <a href={project.data.externalUrl} target="_blank" rel="noopener noreferrer" class="mb-10 inline-block border border-accent px-5 py-2.5 font-mono text-xs uppercase tracking-[0.1em] text-accent hover:bg-accent hover:text-ink">
          Visit website ↗
        </a>
      )}

      <div class="prose-body">
        <Content />
      </div>

      {hasVideos && (
        <div class="mt-14 flex flex-col gap-10">
          {videos.map((v) => v.parsed && (
            <div>
              <div class="aspect-video overflow-hidden border border-line bg-surface">
                {v.parsed.type === "embed" ? (
                  <iframe
                    src={v.parsed.src}
                    class="h-full w-full border-0"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    title={v.caption ?? project.data.title}
                  ></iframe>
                ) : (
                  <video
                    class="h-full w-full border-0"
                    controls
                    preload="metadata"
                    playsinline
                    poster={v.poster || undefined}
                  >
                    <source src={v.parsed.src} type={v.parsed.mime} />
                  </video>
                )}
              </div>
              {v.caption && <p class="mt-2 font-mono text-xs text-muted">{v.caption}</p>}
            </div>
          ))}
        </div>
      )}

      {project.data.gallery.length > 0 && (
        <div class="mt-14 grid grid-cols-2 gap-3 sm:grid-cols-3">
          {project.data.gallery.map((src) => (
            <div class="aspect-square overflow-hidden border border-line bg-surface">
              <img src={src} alt="" loading="lazy" class="h-full w-full object-cover" />
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
