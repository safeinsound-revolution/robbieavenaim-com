---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="Projects — Robbie Avenaim">
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <p class="eyebrow mb-3">Projects</p>
    <h1 class="mb-12 text-3xl font-bold tracking-tight sm:text-5xl">Current Projects</h1>

    <div class="flex flex-col divide-y divide-line border-t border-line">
      {projects.map((p) => (
        <a href={`/projects/${p.id}/`} class="group grid gap-4 py-8 sm:grid-cols-[200px_1fr] sm:gap-8">
          <div class="aspect-[4/3] overflow-hidden border border-line bg-surface">
            {p.data.heroImage && (
              <img src={p.data.heroImage} alt={p.data.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
            )}
          </div>
          <div class="flex flex-col justify-center">
            <h2 class="text-xl font-bold tracking-tight group-hover:text-accent sm:text-2xl">{p.data.title}</h2>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{p.data.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
