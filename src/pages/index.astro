---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import home from "../content/home.json";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="Robbie Avenaim — Drummer, Sound & Installation Artist">
  <section class="relative">
    <div class="relative aspect-[4/3] w-full overflow-hidden sm:aspect-[16/9] lg:aspect-[21/9]">
      <img
        src={home.heroImage}
        alt={home.heroCaption ?? "Robbie Avenaim"}
        class="h-full w-full object-cover object-top opacity-90"
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-transparent"></div>
    </div>
    <div class="mx-auto max-w-6xl px-5 pb-14 sm:px-8">
      <p class="eyebrow mb-3">Drums / Sound / Installation</p>
      <h1 class="max-w-3xl text-3xl font-bold leading-tight tracking-tight sm:text-5xl">
        Robbie Avenaim
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
        {home.intro}
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/about/" class="border border-accent px-5 py-2.5 font-mono text-xs uppercase tracking-[0.1em] text-accent transition-colors hover:bg-accent hover:text-ink">
          Read the biography
        </a>
        <a href="/projects/" class="border border-line px-5 py-2.5 font-mono text-xs uppercase tracking-[0.1em] text-paper transition-colors hover:border-paper">
          Current projects
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="mb-8 flex items-baseline justify-between">
      <h2 class="text-xl font-bold tracking-tight sm:text-2xl">Projects</h2>
      <a href="/projects/" class="font-mono text-xs uppercase tracking-[0.1em] text-muted hover:text-accent">View all →</a>
    </div>
    <div class="grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <a href={`/projects/${p.id}/`} class="group relative flex min-h-[220px] flex-col justify-end bg-ink p-6">
          {p.data.heroImage && (
            <img
              src={p.data.heroImage}
              alt={p.data.title}
              class="absolute inset-0 h-full w-full object-cover opacity-30 transition-opacity duration-300 group-hover:opacity-50"
            />
          )}
          <div class="relative">
            <h3 class="text-lg font-bold leading-snug">{p.data.title}</h3>
            <p class="mt-2 line-clamp-2 text-sm text-muted">{p.data.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
