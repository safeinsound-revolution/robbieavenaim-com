---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import home from "../content/home.json";

const projects = (await getCollection("projects")).sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity));

// The Upcoming Events section only renders when the CMS toggle is on *and*
// at least one event has been added — so it disappears on its own when empty.
type HomeEvent = {
  date: string;
  title: string;
  venue?: string;
  details?: string;
  link?: string;
  linkLabel?: string;
};
const events: HomeEvent[] = (home as { upcomingEvents?: HomeEvent[] }).upcomingEvents ?? [];
const showEvents = home.showUpcomingEvents !== false && events.length > 0;
---
<Layout title="Robbie Avenaim — Drummer, Sound & Installation Artist">
  <section class="relative">
    <div class="relative aspect-[4/3] w-full overflow-hidden sm:aspect-[3/2] lg:aspect-[16/10]">
      <img
        src={home.heroImage}
        alt={home.heroCaption ?? "Robbie Avenaim"}
        class="h-full w-full object-cover object-top opacity-90"
      />
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-[14%]"
        style="background-image: linear-gradient(to top, var(--color-ink) 0%, color-mix(in srgb, var(--color-ink) 40%, transparent) 35%, transparent 100%)"
      ></div>
    </div>
    <a
      id="scroll-cue"
      href="#intro"
      aria-label="Scroll down"
      class="fixed bottom-5 left-1/2 z-40 -translate-x-1/2 rounded-full p-2 text-paper/90 drop-shadow-[0_1px_4px_rgba(0,0,0,0.75)] transition-opacity duration-500 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7 motion-safe:animate-bounce" aria-hidden="true">
        <path d="M12 5v14M6 13l6 6 6-6" />
      </svg>
    </a>
    <div id="intro" class="mx-auto max-w-6xl scroll-mt-24 px-5 pt-10 pb-14 sm:px-8 sm:pt-12">
      <p class="eyebrow mb-3">Drums / Sound / Installation</p>
      <h1 class="max-w-3xl text-3xl font-bold leading-tight tracking-tight sm:text-5xl">
        Robbie Avenaim
      </h1>
    </div>
  </section>

  {showEvents && (
    <section class="mx-auto max-w-6xl px-5 pb-4 sm:px-8">
      <h2 class="mb-8 text-xl font-bold tracking-tight sm:text-2xl">Upcoming Events</h2>
      <ul class="flex flex-col divide-y divide-line border-y border-line">
        {events.map((e) => (
          <li class="flex flex-col gap-2 py-5 sm:flex-row sm:gap-8">
            <span class="w-44 shrink-0 font-mono text-sm text-accent">{e.date}</span>
            <div class="flex-1">
              <h3 class="text-lg font-bold leading-snug">{e.title}</h3>
              {e.venue && <p class="mt-1 font-mono text-xs uppercase tracking-[0.1em] text-muted">{e.venue}</p>}
              {/* whitespace-pre-line: event details get typed as a poster — date, time,
                  price on their own lines — so the line breaks have to survive. */}
              {e.details && <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-muted">{e.details}</p>}
              {e.link && (
                <a
                  href={e.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-block font-mono text-xs uppercase tracking-[0.1em] text-accent hover:underline"
                >
                  {/* `||`, not `??` — a Link Label the CMS saved blank arrives as ''. */}
                  {e.linkLabel || "More info"} →
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="mb-8 flex items-baseline justify-between">
      <h2 class="text-xl font-bold tracking-tight sm:text-2xl">Project Highlights</h2>
      <a href="/projects/" class="font-mono text-xs uppercase tracking-[0.1em] text-muted hover:text-accent">View all →</a>
    </div>
    <div class="grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <a href={`/projects/${p.id}/`} class="group relative flex min-h-[220px] flex-col justify-end bg-ink p-6">
          {p.data.heroImage && (
            <img
              src={p.data.heroImage}
              alt={p.data.title}
              class="absolute inset-0 h-full w-full object-cover opacity-30 transition-opacity duration-300 group-hover:opacity-50"
            />
          )}
          <div class="relative">
            <h3 class="text-lg font-bold leading-snug">{p.data.title}</h3>
            <p class="mt-2 line-clamp-2 text-sm text-muted">{p.data.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<script>
  // Hide the hero scroll cue once the visitor starts scrolling.
  const cue = document.getElementById("scroll-cue");
  if (cue) {
    const update = () => {
      const scrolled = window.scrollY > 40;
      cue.classList.toggle("opacity-0", scrolled);
      cue.classList.toggle("pointer-events-none", scrolled);
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
